# ==============================================================================
# NEXUS AI: Environment Configuration
# ==============================================================================

# Application
APP_NAME=NEXUS AI
APP_ENV=development
DEBUG=True
API_V1_STR=/api
SECRET_KEY=nexus_super_secret_jwt_encryption_key_change_in_production_32chars!
ACCESS_TOKEN_EXPIRE_MINUTES=1440
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173","http://127.0.0.1:5173"]

# LLM Providers & Agent Settings
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_BASE_URL=https://api.openai.com/v1
DEFAULT_LLM_MODEL=gpt-4o
FAST_LLM_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0.2
MAX_VERIFICATION_RETRIES=2

# External Research APIs
TAVILY_API_KEY=your_tavily_api_key_here
SEMANTIC_SCHOLAR_API_KEY=your_semantic_scholar_api_key_optional
CROSSREF_MAILTO=research@nexus-ai.local

# Databases
# Use PostgreSQL in production or Docker: postgresql+asyncpg://nexus:nexus@localhost:5432/nexus_db
# SQLite fallback is supported out of the box: sqlite+aiosqlite:///./nexus.db
DATABASE_URL=sqlite+aiosqlite:///./nexus.db

# Vector Storage (Qdrant)
# For remote or Docker: http://localhost:6333
# Set to ":memory:" or local path for embedded/local mode
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION_NAME=nexus_research_documents

# Cache & Background Queue
REDIS_URL=redis://localhost:6379/0

# Observability (Langfuse / Ragas)
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# File Storage
UPLOAD_DIR=./uploads
REPORT_OUTPUT_DIR=./reports
MAX_UPLOAD_SIZE_MB=25

